# OS / editor noise
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# dev experiments testing provenence of paragraph→permalink coverage via Claude API
/experiments/

# Python bytecode (from invoking tests/grounded_rate.py + tests/permalink_density.py)
__pycache__/
*.pyc

# CI scanner artifacts (bandit/semgrep SARIF, generated in .github/workflows/security.yml)
*.sarif

# Claude Code local overrides — the repo ships .claude/settings.json but never
# the per-developer sibling. The rule lives here rather than in a contributor's
# global ignore so a fresh clone is protected without local setup.
.claude/settings.local.json
