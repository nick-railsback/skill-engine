#!/usr/bin/env bash
set -euo pipefail

# pre-commit.sh.template - opt-in git pre-commit hook for the skill-engine
#
# What this hook does:
#   Runs every stamped contextualizer's `verify.sh` before each commit —
#   `.claude/skills/<slug>-context/verify.sh`, the location engine-bootstrap
#   stamps it to. If any verify check fails, the commit is aborted (non-zero
#   exit). This gives the same green-bar discipline the release ritual asks
#   for, just earlier in the loop.
#
#   A repo with no stamped contextualizer is an error, not a no-op: this hook
#   exists to gate commits on a green corpus, and one that cannot find a corpus
#   has nothing to gate. It says so and exits non-zero rather than passing
#   silently.
#
# What this hook is NOT:
#   It is not CI. The skill-engine deliberately does not ship CI (the release
#   ritual is reviewer-driven; see 06-release-doctrine.md). This hook is a
#   reviewer convenience, not a release gate.
#
# How to install (opt-in; the project does not auto-install):
#   cp plugin/skill-engine/engine-bootstrap-templates/pre-commit.sh.template \
#     .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#   (the source path is inside your installed skill-engine plugin; see
#    docs/06-release-doctrine.md § the pre-commit hook)
#
# How to uninstall:
#   rm .git/hooks/pre-commit
#
# Usage:
#   Once installed, the hook runs automatically on `git commit`. To bypass for
#   a single commit (rare, deliberate), pass `--no-verify` to git. Routine
#   bypassing defeats the purpose; if you find yourself bypassing often, the
#   verify checks are probably catching something real.
#
# Exit codes:
#   0 - verify passed; commit proceeds
#   1 - verify failed; commit aborted (verify output printed to terminal)

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$REPO_ROOT" ]; then
  echo "pre-commit: not inside a git repository" >&2
  exit 1
fi

# engine-bootstrap stamps verify.sh to .claude/skills/<slug>-context/verify.sh.
# A monorepo can hold several stamped contextualizers, so glob rather than
# resolve one path: every match runs, and any failure aborts the commit.
shopt -s nullglob
VERIFY_SCRIPTS=("$REPO_ROOT"/.claude/skills/*-context/verify.sh)
shopt -u nullglob

if [ "${#VERIFY_SCRIPTS[@]}" -eq 0 ]; then
  echo "pre-commit: no contextualizer verify.sh found under" >&2
  echo "  $REPO_ROOT/.claude/skills/*-context/verify.sh" >&2
  echo "  This hook gates commits on a green corpus; with nothing to verify it" >&2
  echo "  fails rather than passing silently." >&2
  echo "  Scaffold one with the engine-bootstrap workflow, or uninstall the" >&2
  echo "  hook: \`rm .git/hooks/pre-commit\`" >&2
  exit 1
fi

verify_failed=0
for VERIFY_SCRIPT in "${VERIFY_SCRIPTS[@]}"; do
  if ! bash "$VERIFY_SCRIPT"; then
    echo "" >&2
    echo "pre-commit: ${VERIFY_SCRIPT#"$REPO_ROOT/"} failed" >&2
    verify_failed=1
  fi
done

if [ "$verify_failed" -ne 0 ]; then
  echo "" >&2
  echo "pre-commit: verify failed; commit aborted" >&2
  echo "  Re-run the verify.sh named above for full output." >&2
  echo "  To bypass once (rare, deliberate): \`git commit --no-verify\`" >&2
  exit 1
fi

exit 0
